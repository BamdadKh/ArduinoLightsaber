# Large media goes through Git LFS (run `git lfs install` once per machine)
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text

# Binary CAD archives (each revision is a whole new blob).
# STL stays out of LFS so GitHub's 3D viewer can show it.
*.f3z filter=lfs diff=lfs merge=lfs -text
*.f3d filter=lfs diff=lfs merge=lfs -text
*.3mf filter=lfs diff=lfs merge=lfs -text

# KiCad files are text; keep LF so diffs stay clean
*.kicad_pro text eol=lf
*.kicad_sch text eol=lf
*.kicad_pcb text eol=lf
*.ino text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf

# Sound font (small WAVs, kept out of LFS so a clone is ready to copy to SD)
*.wav binary
